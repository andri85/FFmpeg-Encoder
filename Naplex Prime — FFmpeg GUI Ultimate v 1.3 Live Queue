                widget.configure(bg=pal["field"], fg=pal["fg"], insertbackground=pal["fg"],
                                 buttonbackground=pal["panel2"],
                                 selectbackground=pal["select"], selectforeground=pal["yellow"],
                                 relief="flat", highlightthickness=1,
