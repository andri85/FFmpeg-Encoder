    def _new_job(self, src):
        src = str(Path(src).resolve())
        return {
            "id": uuid.uuid4().hex[:12], "source": src, "status": "queued",
            "parts_done": [], "parts_total": 0, "progress": 0.0,
            "current_part": 0, "part_progress": 0.0,
            "speed": "", "fps": "", "eta": "", "elapsed_sec": 0.0,
            "error": "", "created": datetime.now().isoformat(timespec="seconds"),
            "started": None, "finished": None, "attempts": 0,
        }

    def queue_from_tree(self, switch_tab=False):
        items = list(self.tree.get_children())
        added = 0
        with self.queue_lock:
            existing = {j["source"] for j in self.queue_jobs.values()}
            for iid in items:
                src = str(Path(iid).resolve())
                if src in existing or not Path(src).is_file():
                    continue
                j = self._new_job(src)
                self.queue_jobs[j["id"]] = j
                self.queue_order.append(j["id"])
                added += 1
        self.refresh_queue()
        self.after(100, self.refresh_stream_inventory)
        self.logmsg(f"Coda: aggiunti {added} job dalla scansione.", "info")
        if switch_tab:
            try:
                self.notebook.select(self.tab_queue)
            except Exception:
                pass

    def queue_add_files(self):
        files = filedialog.askopenfilenames(title="Aggiungi video alla coda", filetypes=[("Video", "*.mkv *.mp4 *.m4v *.mov *.avi *.ts *.m2ts *.webm *.mpg *.mpeg"), ("Tutti", "*.*")])
        with self.queue_lock:
            existing = {j["source"] for j in self.queue_jobs.values()}
            for f in files:
                src = str(Path(f).resolve())
                if src in existing:
                    continue
                j = self._new_job(src); self.queue_jobs[j["id"]] = j; self.queue_order.append(j["id"]); existing.add(src)
        self.refresh_queue()
        self.after(100, self.refresh_stream_inventory)

    def queue_clear(self):
        """Svuota completamente la coda senza toccare i file sorgente."""
        with self.queue_lock:
            count = len(self.queue_order)
            self.queue_jobs.clear()
            self.queue_order.clear()
        self.refresh_queue()
        self.after(100, self.refresh_stream_inventory)
        self._save_queue_recovery()
        self.logmsg(f"🗑 Coda svuotata: {count} job rimossi.", "info")

    def queue_remove(self):
        sel = self.queue_tree.selection()
        with self.queue_lock:
            for iid in sel:
                self.queue_jobs.pop(iid, None)
                if iid in self.queue_order: self.queue_order.remove(iid)
        self.refresh_queue()
        self.after(100, self.refresh_stream_inventory)

    def queue_move(self, delta):
        sel = self.queue_tree.selection()
        if not sel: return
        jid = sel[0]
        with self.queue_lock:
            try: i = self.queue_order.index(jid)
            except ValueError: return
            j = i + delta
            if not 0 <= j < len(self.queue_order): return
            self.queue_order[i], self.queue_order[j] = self.queue_order[j], self.queue_order[i]
        self.refresh_queue(); self.queue_tree.selection_set(jid)

    @staticmethod
    def _queue_progress_bar(pct, width=10):
        pct = max(0.0, min(100.0, float(pct or 0.0)))
        filled = int(round(width * pct / 100.0))
        return "█" * filled + "░" * (width - filled)

    def _queue_row_values(self, j):
        done = len(j.get("parts_done", []) or [])
        total = int(j.get("parts_total", 0) or 0)
        current_part = int(j.get("current_part", 0) or 0)
        status = str(j.get("status", "queued"))
        labels = {
            "queued": "In coda", "encoding": "Encoding",
            "completed": "Completato", "failed": "Errore",
            "cancelled": "Annullato"
        }
        status_text = labels.get(status, status)
        if status == "encoding" and current_part:
            status_text += f" · parte {current_part}/{total or '?'}"

        parts_text = f"{done}/{total or '-'}"
        if status == "encoding" and current_part:
            part_pct = max(0.0, min(100.0, float(j.get("part_progress", 0.0) or 0.0)))
            parts_text += f" · #{current_part} {part_pct:.0f}%"
        pct = max(0.0, min(100.0, float(j.get("progress", 0.0) or 0.0)))
        progress_text = f"{self._queue_progress_bar(pct)} {pct:5.1f}%"
        speed = str(j.get("speed") or "—")
        fps = str(j.get("fps") or "").strip()
        if fps:
            speed = f"{speed} · {fps} fps"
        eta = str(j.get("eta") or "—")
        elapsed = self._fmt_eta(float(j.get("elapsed_sec", 0.0) or 0.0))
        return (Path(j["source"]).name, status_text, parts_text, progress_text,
                speed, eta, elapsed, j.get("error", ""))

    def refresh_queue(self):
        # Coalescing: evita centinaia di ridisegni quando FFmpeg emette progress
        # molto rapidamente. L'update reale avviene sempre nel thread Tk.
        def request():
            if self._queue_refresh_pending:
                return
            self._queue_refresh_pending = True
            self.after(60, self._refresh_queue_ui)
        try:
            self.after(0, request)
        except Exception:
            pass

    def _refresh_queue_ui(self):
        self._queue_refresh_pending = False
        try:
            with self.queue_lock:
                jobs = [(jid, dict(self.queue_jobs[jid]))
                        for jid in self.queue_order if jid in self.queue_jobs]

            wanted = [jid for jid, _ in jobs]
            wanted_set = set(wanted)
            current = set(self.queue_tree.get_children())

            for iid in current - wanted_set:
                self.queue_tree.delete(iid)

            for pos, (jid, job) in enumerate(jobs):
                values = self._queue_row_values(job)
                if self.queue_tree.exists(jid):
                    self.queue_tree.item(jid, values=values)
                    self.queue_tree.move(jid, "", pos)
                else:
                    self.queue_tree.insert("", "end", iid=jid, values=values)

            total = len(jobs)
            completed = sum(1 for _, j in jobs if j.get("status") == "completed")
            failed = sum(1 for _, j in jobs if j.get("status") == "failed")
            active = sum(1 for _, j in jobs if j.get("status") == "encoding")
            queued = sum(1 for _, j in jobs if j.get("status") == "queued")
            overall = (sum(float(j.get("progress", 0.0) or 0.0) for _, j in jobs) / total) if total else 0.0
            self.queue_summary_var.set(
                f"Coda: {total} · attivi {active} · in attesa {queued} · "
                f"completati {completed} · errori {failed} · avanzamento {overall:.1f}%"
            )
        except Exception:
            pass

    def _job_for_source_locked(self, src):
        src = str(Path(src).resolve())
        for jid, j in self.queue_jobs.items():
            try:
                if str(Path(j["source"]).resolve()) == src:
                    return jid, j
            except Exception:
                continue
        return None, None

    def _update_job_live_progress(self, src, part, total, part_pct, speed="", fps="", eta="", elapsed=0.0):
        """Aggiorna il progress del job mentre FFmpeg sta ancora codificando.

        Il valore in coda è complessivo del file, non soltanto della parte
        corrente. Con più worker ogni callback aggiorna esclusivamente il job
        associato al proprio sorgente.
        """
        if src is None:
            return max(0.0, min(100.0, float(part_pct or 0.0)))
        result = 0.0
        with self.queue_lock:
            _jid, j = self._job_for_source_locked(src)
            if j is None:
                return max(0.0, min(100.0, float(part_pct or 0.0)))
            part = max(1, int(part or 1))
            total = max(part, int(total or 1), int(j.get("parts_total", 0) or 0))
            part_pct = max(0.0, min(100.0, float(part_pct or 0.0)))
            done = set(int(x) for x in (j.get("parts_done", []) or []))
            completed_credit = len([x for x in done if x != part])
            computed = ((completed_credit + part_pct / 100.0) / max(1, total)) * 100.0
            # Mantiene il progress monotono durante retry/ricodifica della stessa parte.
            result = max(float(j.get("progress", 0.0) or 0.0), computed)
            if result >= 100.0 and part_pct < 100.0:
                result = 99.9
            j["status"] = "encoding"
            j["parts_total"] = total
            j["current_part"] = part
            j["part_progress"] = part_pct
            j["progress"] = min(100.0, result)
            j["speed"] = speed or j.get("speed", "")
            j["fps"] = fps or j.get("fps", "")
            j["eta"] = eta or ""
            j["elapsed_sec"] = max(0.0, float(elapsed or 0.0))
            j["updated"] = datetime.now().isoformat(timespec="seconds")
            result = j["progress"]
        self.refresh_queue()
        self._persist_queue_throttled()
        return result

    def _persist_queue_throttled(self, interval=5.0):
        now = time.monotonic()
        if now - self._queue_last_persist < interval:
            return
        self._queue_last_persist = now
        self._persist_queue_silent()

