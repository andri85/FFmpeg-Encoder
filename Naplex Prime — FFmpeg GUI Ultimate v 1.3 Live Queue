    def cleanup_temp_files(self):
        roots = set()
        for d in self.output_dirs:
            roots.add(Path(d))
        if self.folder.get():
            roots.add(Path(self.folder.get()))
        removed = 0
        for root in roots:
            if not root.exists():
                continue
            try:
                for p in root.rglob(".naplex19_tmp_*"):
                    if p.is_file():
                        try:
                            p.unlink()
                            removed += 1
                        except OSError:
                            pass
            except Exception:
                pass
        self.logmsg(f"🧹 Pulizia temporanei completata: {removed} file rimossi.", "ok")

