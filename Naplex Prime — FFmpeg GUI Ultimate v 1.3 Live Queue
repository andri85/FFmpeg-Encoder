    def _mark_part_done(self, src, part, total, output_size=0):
        with self.queue_lock:
            _jid, j = self._job_for_source_locked(src)
            if j is not None:
                done = set(int(x) for x in (j.get("parts_done", []) or []))
                is_new = int(part) not in done
                done.add(int(part))
                j["parts_done"] = sorted(done)
                j["parts_total"] = max(int(total or 0), int(part), int(j.get("parts_total", 0) or 0))
                j["progress"] = min(100.0, (len(done) / max(1, j["parts_total"])) * 100.0)
                j["part_progress"] = 100.0
                j["current_part"] = int(part)
                j["eta"] = "0s"
                j["status"] = "encoding"
        with self._session_lock:
            if 'is_new' in locals() and is_new:
                self._session_parts += 1
                self._session_output_bytes += int(output_size)
                self._session_verified += 1 if self.verify_output.get() else 0
        self.refresh_queue(); self._persist_queue_silent()

